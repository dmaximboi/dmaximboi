{
  "name": "dmaximboi",
  "private": true,
  "scripts": {
    "build": "turbo build --filter=@dmaximboi/web && node -e \"require('fs').cpSync('apps/web/dist','dist',{recursive:true,force:true})\"",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,css,md}\""
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.3.3"
  },
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
